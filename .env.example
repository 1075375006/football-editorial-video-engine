# Keep the default provider as none for offline rendering and CI.
FEE_IMAGE_PROVIDER=none

# OpenAI-compatible providers and transparent relays.
# Set FEE_IMAGE_RELAY_URL to a gateway that exposes the same /images/generations route.
FEE_IMAGE_API_KEY=
FEE_IMAGE_BASE_URL=https://api.openai.com/v1
FEE_IMAGE_RELAY_URL=
FEE_IMAGE_MODEL=gpt-image-1

# Leonardo AI. Use a trusted HTTPS relay by setting LEONARDO_API_BASE_URL.
LEONARDO_API_KEY=
LEONARDO_API_BASE_URL=https://cloud.leonardo.ai/api/rest/v1
LEONARDO_MODEL_ID=

# Runtime controls.
FEE_IMAGE_TIMEOUT_MS=45000
FEE_IMAGE_POLL_INTERVAL_MS=2000
FEE_IMAGE_POLL_TIMEOUT_MS=120000
FEE_IMAGE_DRY_RUN=0
FEE_IMAGE_STRICT=0
# Optional JSON headers for a gateway, for example {"X-Gateway-Key":"..."}.
FEE_IMAGE_EXTRA_HEADERS_JSON=
